{
  "name": "@vaultui/marketing",
  "version": "0.1.0",
  "description": "Marketing Kit \u2014 hero, feature grids, stats, testimonials, logos, FAQ, newsletter sections",
  "license": "SEE LICENSE IN ../COMMERCIAL-LICENSE.md",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./marketing.css": "./src/marketing.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@vaultui/tokens": "workspace:*",
    "@vaultui/ui": "workspace:*",
    "@vaultui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "@vaultui/configs": "workspace:*"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "clean": true,
    "sourcemap": true,
    "external": [
      "react",
      "react-dom",
      "react/jsx-runtime",
      "@vaultui/utils",
      "@vaultui/tokens",
      "@vaultui/ui"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
