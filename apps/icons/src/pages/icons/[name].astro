---
import { readFileSync } from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import manifestJson from "../../../public/data/manifest.json";

const dataRoot = path.join(process.cwd(), "public", "data");
const manifest = manifestJson as {
  weights: string[];
  icons: { name: string; category: string; tags: string[] }[];
  categories: { id: string; label: string }[];
};
const weights: string[] = manifest.weights;

const shardCache = new Map<string, Record<string, string>>();
function svgFor(name: string, weight: string): string {
  const letter = /[a-z]/i.test(name[0]) ? name[0].toLowerCase() : "_";
  const key = `${weight}/${letter}`;
  if (!shardCache.has(key)) {
    shardCache.set(
      key,
      JSON.parse(readFileSync(path.join(dataRoot, "payload", weight, `${letter}.json`), "utf8")),
    );
  }
  return shardCache.get(key)?.[name] ?? "";
}

export function getStaticPaths() {
  return (manifestJson as { icons: { name: string; category: string; tags: string[] }[] }).icons.map(
    (icon) => ({
      params: { name: icon.name },
      props: { icon },
    }),
  );
}

const { icon } = Astro.props as { icon: { name: string; category: string; tags: string[] } };
const category = manifest.categories.find((entry: { id: string }) => entry.id === icon.category);
const svg = svgFor(icon.name, "regular");
const label = (weight: string) => weight.charAt(0).toUpperCase() + weight.slice(1);

const canonical = new URL(`/icons/${icon.name}`, Astro.site ?? "https://icons.abhayaui.workers.dev").toString();
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: `${icon.name} icon`,
  description: `${icon.name} — ${category?.label ?? "icon"} in six weights, optimized SVG with currentColor.`,
  keywords: icon.tags.join(", "),
  url: canonical,
  isPartOf: {
    "@type": "CollectionPage",
    name: "Abhayaui Icons",
    url: new URL("/", Astro.site ?? "https://icons.abhayaui.workers.dev").toString(),
  },
});
---

<BaseLayout
  title={`${icon.name} icon — Abhayaui Icons`}
  description={`${icon.name} — ${category?.label ?? "icon"} in six weights. Free SVG, ready for React, Vue and Svelte.`}
>
  <style is:global>
    .icon-preview svg {
      width: 32px;
      height: 32px;
      display: block;
    }
  </style>

  <script type="application/ld+json" set:html={jsonLd} />

  <main class="min-h-dvh">
    <div class="mx-auto max-w-[900px] px-6 py-10">
      <nav class="flex flex-wrap items-center justify-between gap-3">
        <a href="/" class="text-[14px] font-medium" style="color: var(--color-brand-700)">← All icons</a>
        <a href={`/#${icon.name}`} class="text-[14px]" style="color: var(--color-surface-600)">Open in explorer</a>
      </nav>

      <header class="mt-10">
        <p class="text-[12px] font-bold uppercase tracking-[0.14em]" style="color: var(--color-surface-500)">Icon</p>
        <h1 class="text-[48px] leading-[1.05] font-semibold mt-1" style="letter-spacing: -0.03em">{icon.name}</h1>
        <p class="mt-3 flex flex-wrap items-center gap-2 text-[14px]" style="color: var(--color-surface-600)">
          <span class="drawer__chip">
            <span class="drawer__dot"></span>{category?.label}
          </span>
          <span aria-hidden="true">·</span>
          <span>Six weights</span>
          <span aria-hidden="true">·</span>
          <span>currentColor</span>
        </p>
      </header>

      <section class="mt-8" aria-labelledby="weights-heading">
        <h2 id="weights-heading" class="text-[12px] font-bold uppercase tracking-[0.14em] mb-3" style="color: var(--color-surface-600)">
          All weights
        </h2>
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-3">
          {weights.map((weight) => (
            <figure
              class="rounded-lg border p-4 grid place-items-center gap-2"
              style="border-color: var(--color-surface-200); background: var(--color-surface-0)"
            >
              <div class="icon-preview" set:html={svgFor(icon.name, weight)} />
              <figcaption class="text-[12px]" style="color: var(--color-surface-600)">{label(weight)}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="mt-10" aria-labelledby="code-heading">
        <h2 id="code-heading" class="text-[12px] font-bold uppercase tracking-[0.14em] mb-3" style="color: var(--color-surface-600)">
          SVG
        </h2>
        <div class="code-well">
          <pre><code>{svg}</code></pre>
        </div>
      </section>

      <footer class="mt-8 flex flex-wrap items-center gap-2 text-[12px]" style="color: var(--color-surface-600)">
        <span>Tags</span>
        {icon.tags.map((tag: string) => (
          <span class="rounded-full px-2 py-0.5" style="background: var(--color-surface-100)">{tag}</span>
        ))}
      </footer>
    </div>
  </main>
</BaseLayout>
