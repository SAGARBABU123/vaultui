---
interface Props {
  categories: { id: string; label: string }[];
}

const { categories } = Astro.props;
---

<aside class="sidebar" id="sidebar" aria-label="Icon library navigation">
  <div class="sidebar__head">
    <span
      class="grid place-items-center w-9 h-9 rounded-lg shrink-0"
      style="background: linear-gradient(140deg, var(--color-brand-100), var(--color-brand-50)); box-shadow: inset 0 0 0 1px var(--color-brand-200)"
      aria-hidden="true"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-600)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7Z" />
        <circle cx="12" cy="12" r="3.2" stroke="var(--color-brand-500)" />
        <path d="M12 8.8v6.4" stroke="var(--color-brand-500)" />
      </svg>
    </span>
    <div class="min-w-0">
      <p class="text-[16px] font-semibold leading-tight" style="color: var(--color-surface-900)">Abhayaui Icons</p>
      <p class="text-[12px] leading-tight mt-0.5" style="color: var(--color-surface-600)">Six weights · 256 grid</p>
    </div>
    <button
      type="button"
      class="ml-auto lg:hidden grid place-items-center w-8 h-8 rounded-md"
      data-sidebar-close
      aria-label="Close navigation"
      style="color: var(--color-surface-600); background: var(--color-surface-100)"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </div>

  <div class="sidebar__scroll flex-1 px-2 py-4">
    <section aria-labelledby="category-heading">
      <h2 id="category-heading" class="px-2 mb-2 text-[12px] font-bold uppercase tracking-[0.14em]" style="color: var(--color-surface-600)">
        Categories
      </h2>
      <nav class="flex flex-col gap-0.5">
        <button type="button" class="side-item" data-category="all" aria-current="true">
          <span class="flex-1 text-left">All icons</span>
        </button>
        {categories.map((category) => (
          <button type="button" class="side-item" data-category={category.id} aria-current="false">
            <span class="flex-1 text-left truncate">{category.label}</span>
          </button>
        ))}
      </nav>
    </section>

    <section class="mt-6" aria-labelledby="pages-heading">
      <h2 id="pages-heading" class="px-2 mb-2 text-[12px] font-bold uppercase tracking-[0.14em]" style="color: var(--color-surface-600)">
        About
      </h2>
      <nav class="flex flex-col gap-0.5">
        <a href="/philosophy" class="side-item">
          <span class="flex-1 text-left">Philosophy</span>
        </a>
      </nav>
    </section>
  </div>
</aside>

<div class="sidebar-backdrop" data-sidebar-backdrop></div>
