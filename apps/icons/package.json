{
  "name": "@vaultui/icons-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vault Icons — static icon library explorer (Astro + Tailwind v4).",
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "dev": "node scripts/sync-data.mjs && astro dev",
    "build": "node scripts/sync-data.mjs && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@vaultui/icons": "workspace:*",
    "@vaultui/tokens": "workspace:*",
    "astro": "^7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
