{
  "name": "@vaultui/showroom",
  "version": "0.0.1",
  "private": true,
  "description": "Vault UI showroom \u2014 the Storybook storefront",
  "scripts": {
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build -o dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vaultui/tokens": "workspace:*",
    "@vaultui/ui": "workspace:*",
    "@vaultui/utils": "workspace:*",
    "@vaultui/data-viz": "workspace:*",
    "@vaultui/marketing": "workspace:*"
  },
  "devDependencies": {
    "@vaultui/configs": "workspace:*",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.10"
  }
}
