# Supabase — real auth for the Vault UI app.
# Create a free project at https://supabase.com, then copy these values from
# Project Settings → API. When BOTH are set, the app uses real Supabase auth
# (email verification, password reset, RLS-gated premium role). Without them
# the app runs in hardened demo mode. Never commit real keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=