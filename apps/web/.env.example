# Supabase — real auth for the Vault UI app.
# Create a free project at https://supabase.com, then copy these values from
# Project Settings → API. When BOTH are set, the app uses real Supabase auth
# (email verification, password reset, RLS-gated premium role). Without them
# the app runs in hardened demo mode. Never commit real keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini — optional AI fallback for "Ask the kit".
# Get a free key at https://aistudio.google.com/apikey, then set it in the
# Vercel dashboard (Environment Variables) so it only ever lives server-side
# (api/ask.ts reads it; it never ships in the browser bundle).
# GEMINI_MODEL is optional (default: gemini-3.6-flash).
GEMINI_API_KEY=
GEMINI_MODEL=